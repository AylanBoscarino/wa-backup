# wa-backup configuration

# Filesystem root where backups are written.
LOCAL_BACKUP_PATH=./backup

# Path to the SQLite database that persists the WhatsApp session.
# Deleting this file forces a fresh QR scan on next start.
SESSION_DB_PATH=./wa-session.db

# Comma-separated list of group JIDs to monitor.
# Example: 120363012345678901@g.us,120363099999999999@g.us
# If empty, GROUP_DENYLIST is consulted. If both empty, all groups are saved.
GROUP_ALLOWLIST=

# Comma-separated list of group JIDs to ignore. Only used when allowlist is empty.
GROUP_DENYLIST=

# Number of goroutines downloading media in parallel.
MEDIA_WORKERS=4

# Logging level: debug | info | warn | error.
LOG_LEVEL=info

# Idle timeout used to detect the end of a history sync burst.
HISTORY_SYNC_IDLE=30s
